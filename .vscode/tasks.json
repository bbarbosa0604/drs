{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Aprovar hooks do Codex",
      "detail": "Abre a tela de revisão e confiança dos hooks deste projeto.",
      "type": "shell",
      "command": "node",
      "args": [
        ".codex/open-hook-review.cjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
