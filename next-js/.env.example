# URL do backend NestJS, INCLUINDO o prefixo global /api
# (app.setGlobalPrefix('api') em backend/src/main.ts) — server-side apenas,
# nunca prefixar com NEXT_PUBLIC_ (ver next-js/docs/ai/SECURITY.md).
# Local: http://localhost:3000/api. Producao: https://api.drs.fasters.com.br/api
BACKEND_API_URL=http://localhost:3000/api
